# NoneBot 官方 OneBot v11 正向 WebSocket 配置。token 放独立字段。
DRIVER=~aiohttp
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=

# 默认封闭范围；空名单不接收消息。
DORAYMON_ACCESS_MODE=allowlist
DORAYMON_ALLOWED_USERS=[]
DORAYMON_ALLOWED_GROUPS=[]
DORAYMON_ADMIN_USERS=[]

DORAYMON_MODEL_KEY=
DORAYMON_MODEL_URL=https://api.deepseek.com
DORAYMON_MODEL_NAME=deepseek-v4-flash
DORAYMON_AMAP_KEY=
DORAYMON_DEFAULT_LOCATION=江西师范大学瑶湖校区
DORAYMON_DATABASE=data/runtime.sqlite3
DORAYMON_KNOWLEDGE_ENABLED=false

# 电脑桥接启用时，填本机共享租约路径；WSL 路径用 /mnt/c/...。
# DORAYMON_BRIDGE_LEASE=/path/to/bridge-lease.json
