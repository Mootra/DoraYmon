QQBOT_APPID=
QQBOT_SECRET=
QQBOT_SANDBOX=true
# 官方平台只允许在窗口内被动回复有限条数（私聊 60 分钟 4 条、群 5 分钟 5 条）。
# 开启后本地先按额度截断，避免被平台拒绝。
QQBOT_REPLY_WINDOW_ENABLED=true

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7

BOT_COMMAND_PREFIX=/
# 本地问答和附近餐饮的默认起点；用户明确提到其他地点时优先使用用户地点。
BOT_DEFAULT_LOCATION=江西师范大学瑶湖校区
BOT_ADMIN_OPENIDS=
# 启动即静默：机器人只回管理员的 /静默 命令，其余消息一律不回。
# 用于刚上线先观察流量的阶段；也可以运行中用 /静默 on|off 切换。
BOT_SILENCE=false

# 每日模型额度（按 token 计）。0 表示不限制。
# 用 token 而不是金额：token 由接口回报、可以直接测；金额需要价目表，而价目表会变，报一个错的成本比不报更糟。
BOT_DAILY_TOKEN_CAP=0
# 可选，仅用于显示估算金额（每百万 token 的人民币单价）。留空则不显示金额。
BOT_MODEL_PRICE_PER_MILLION_CNY=
BOT_ENABLE_FOOD_NATURAL_TRIGGER=true
# 人工整理的店铺/餐点目录。普通选菜可用规则库；附近店铺必须有真实来源。
BOT_MEAL_CATALOG_DIR=data/meal_catalog
# 可选的地图服务。amap 使用高德 Web 服务 Key；留空不发起地图查询。
BOT_NEARBY_PROVIDER=
BOT_NEARBY_PROVIDER_KEY=
# 目前支持 amap（高德）。BOT_NEARBY_PROVIDER_KEY 只放在本地 .env，绝不提交。
BOT_NEARBY_PROVIDER_CITY=
BOT_NEARBY_PROVIDER_RADIUS_METERS=1500
BOT_ENABLE_CHAT_HISTORY=true
BOT_CHAT_HISTORY_LIMIT=40
BOT_CHAT_HISTORY_MAX_CONTENT_LENGTH=4000
BOT_CHAT_CONTEXT_MAX_CHARS=6000
BOT_CHAT_CONTEXT_SUMMARY_MAX_CHARS=1200
BOT_CHAT_CONTEXT_TTL_MINUTES=720
BOT_CHAT_SUMMARY_RETENTION_DAYS=7
BOT_REPLY_MAX_SEGMENTS=3
BOT_REPLY_MAX_TOTAL_CHARS=4000
BOT_ENABLE_RAG=false
BOT_KNOWLEDGE_DIR=resources/knowledge
BOT_RAG_TOP_K=3
BOT_RAG_TOKENIZER=trigram
BOT_RAG_MAX_CONTEXT_CHARS=6000
BOT_RAG_CHUNK_MAX_CHARS=800
BOT_RAG_CHUNK_OVERLAP_CHARS=100

# QQ 账号入口（OneBot v11 / NapCat）。默认关闭：它会驱动一个真实 QQ 号。
# chat 接收普通私聊和群聊；allowlist 用于只接收指定好友/群的封闭验收。
BOT_QQ_ACCOUNT_ENABLED=false
BOT_QQ_ACCOUNT_ACCESS_MODE=chat
BOT_QQ_ACCOUNT_SELF_ID=
BOT_QQ_ACCOUNT_WS_URL=ws://127.0.0.1:3001
BOT_QQ_ACCOUNT_TOKEN=
# chat 模式：群列表有值则限定这些群，留空处理账号所在群；私聊和群成员不受好友列表过滤。
# allowlist 模式：两项都是允许列表，不可同时为空；同时有值时群成员也须在好友列表。
BOT_QQ_ACCOUNT_GROUPS=
BOT_QQ_ACCOUNT_FRIENDS=
BOT_QQ_ACCOUNT_GROUP_REPLY_MODE=reply
BOT_QQ_ACCOUNT_BOT_NAMES=DoraYmon,哆啦A梦,哆啦,小哆
# 普通群消息按内容选择性接话；关闭后仍响应 @、引用、叫名字、命令和连续追问。
BOT_QQ_ACCOUNT_GROUP_PARTICIPATION_ENABLED=true
# 普通参与按群计：冷却 30 秒、60 秒最多 2 轮；成功送达后计数。
BOT_QQ_ACCOUNT_GROUP_PARTICIPATION_COOLDOWN_SECONDS=30
BOT_QQ_ACCOUNT_GROUP_PARTICIPATION_MAX_REPLIES=2
# 直接请求/连续追问独立计数：无默认冷却，60 秒最多 8 段；旧配置的非零冷却仍生效。
BOT_QQ_ACCOUNT_GROUP_COOLDOWN_SECONDS=0
BOT_QQ_ACCOUNT_GROUP_MAX_REPLIES=8
BOT_QQ_ACCOUNT_GROUP_RATE_WINDOW_SECONDS=60

# 飞书入口（企业自建应用 + 官方长连接）。默认关闭：它需要真实应用凭证。
# 后台把事件订阅方式设为「使用长连接接收事件」，并订阅 im.message.receive_v1；
# 应用必须发布版本，否则收不到事件。BOT_FEISHU_BOT_OPEN_ID 是**机器人自己**的
# open_id（不是 App ID）：群聊里靠它判断有没有被 @，缺了入口会拒绝启动。
BOT_FEISHU_ENABLED=false
BOT_FEISHU_APP_ID=
BOT_FEISHU_APP_SECRET=
BOT_FEISHU_BOT_OPEN_ID=
# 允许列表，默认拒绝：群用 chat_id（oc_ 开头），私聊用发送者 open_id（ou_ 开头）。
BOT_FEISHU_CHATS=
BOT_FEISHU_USERS=
BOT_FEISHU_GROUP_REPLY_MODE=reply
# 自设的群内节流，默认开启；设为 0 可关闭对应限制。
BOT_FEISHU_GROUP_COOLDOWN_SECONDS=3
BOT_FEISHU_GROUP_MAX_REPLIES=8
BOT_FEISHU_GROUP_RATE_WINDOW_SECONDS=60
# feishu（open.feishu.cn）或 lark（open.larksuite.com）：两边不共用域名，
# 填错会表现为「凭证无效」。
BOT_FEISHU_DOMAIN=feishu
BOT_FEISHU_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
