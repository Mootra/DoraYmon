{
  "manifest_version": 2,
  "id": "mootra.doraymon-meal",
  "version": "0.3.0",
  "name": "DoraYmon 用餐",
  "description": "按类别和校内外随机选店，查询地图餐厅，整理带出处的资料，支持追问、地图与资料导出。",
  "author": {
    "name": "Mootra",
    "url": "https://github.com/Mootra"
  },
  "license": "UNLICENSED",
  "urls": {
    "repository": "https://github.com/Mootra/DoraYmon"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.custom",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
